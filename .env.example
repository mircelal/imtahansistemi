# Common
PROJECT_NAME=OMR Exam System
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-me-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=120

# Database
POSTGRES_DB=omr_exam
POSTGRES_USER=omr_user
POSTGRES_PASSWORD=omr_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omr_user:omr_pass@postgres:5432/omr_exam
SYNC_DATABASE_URL=postgresql://omr_user:omr_pass@postgres:5432/omr_exam

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_SHEETS=answer-sheets

# OMR Service
OMR_SERVICE_URL=http://omr-service:8001
OMR_CONFIDENCE_THRESHOLD=0.85
OMR_MARKER_PATH=/app/assets/omr_marker.jpg

# Frontend (Vite dev): boş saxlayın — sorğular /api ilə gedir, vite.config proxy backendə yönləndirir.
# Docker / birbaşa backend: http://localhost:8000
VITE_API_BASE_URL=
