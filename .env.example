# Common
PROJECT_NAME=OMR Exam System
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=replace-me-with-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
MOBILE_APP_SCHEME=imtahansistemi
# Optional SİMA (Phase 3 stub)
SIMA_ENABLED=false
# SIMA_CLIENT_ID=
# SIMA_AUTH_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,https://your-domain.example
RATE_LIMIT_PER_MINUTE=120
# Optional: if set, first-admin bootstrap requires matching X-Bootstrap-Token header or body setup_token
# BOOTSTRAP_SETUP_TOKEN=

# Database
POSTGRES_DB=omr_exam
POSTGRES_USER=omr_user
POSTGRES_PASSWORD=omr_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omr_user:omr_pass@postgres:5432/omr_exam
SYNC_DATABASE_URL=postgresql://omr_user:omr_pass@postgres:5432/omr_exam

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# 0 = host CPU sayı (nproc). Kiçik VDS-də avtomatik az, böyük serverdə çox paralel kart.
CELERY_CONCURRENCY=0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_SHEETS=answer-sheets

# OMR Service
OMR_SERVICE_URL=http://omr-service:8001
OMR_CONFIDENCE_THRESHOLD=0.85
OMR_MARKER_PATH=/app/assets/omr_marker.jpg
# 0 = host CPU sayı. Throughput ≈ min(CELERY_CONCURRENCY, OMR_UVICORN_WORKERS) / sheet_seconds
OMR_UVICORN_WORKERS=0
# Variant axtarışında erkən çıxış (1=açıq). OMR_MAX_VARIANTS=0 → limit yox
OMR_EARLY_EXIT=1
OMR_MAX_VARIANTS=0

# Frontend (Vite dev): boş saxlayın — sorğular /api ilə gedir, vite.config proxy backendə yönləndirir.
# Docker / birbaşa backend: http://localhost:8000
# Docker host port (docker-compose.yml frontend). Laragon/3000 məşğuldursa 3002.
FRONTEND_HOST_PORT=3002
VITE_API_BASE_URL=

# Wallet / online payments
WALLET_ENABLED=true
# PUBLIC_APP_URL=https://bilik.sayt.cam
# Payriff (optional — leave empty until live)
# PAYRIFF_MERCHANT_ID=
# PAYRIFF_SECRET_KEY=
# PAYRIFF_CHECKOUT_BASE=

# Cloudflare / public domain (docker-compose.cloudflare.yml)
# PUBLIC_URL=https://imtahan.example.com
# GATEWAY_HTTP_PORT=80
# Laragon/Apache 80 portunu tutursa: ya Laragon Apache-ni dayandırın, ya Tunnel istifadə edin (aşağıya baxın).
# CORS_ORIGINS-ə https://imtahan.example.com əlavə edin (http və https variantları)
# CLOUDFLARE_TUNNEL_TOKEN=   # yalnız tunnel profili üçün (docker-compose.cloudflare-tunnel.yml)
